[
 {
  "id": "042fa16dfe2ccf6510180b3fbf0492c064197579",
  "text": "처음에는 진실과 조금 밖에 빗나가지 않은 것이라도 후에는 천 배나 벌어지게 된다.",
  "author": "아리스토텔레스",
  "theme": "wisdom",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "0922bfcf65686da2a8fc0e0cafb051b556ce24cf",
  "text": "황금 보기를 돌같이 하라.",
  "author": "최영",
  "theme": "wisdom",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "0b698e77e337fc86e32c4812fce90bb3f1515e46",
  "text": "내가 아는 전부는 내가 아무것도 모른다는 사실이다. --플라톤의 기록",
  "author": "소크라테스",
  "theme": "wisdom",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "2f874e8fc55046f83f79b410253c5caf66ac2c38",
  "text": "사는 것이 중요한 문제가 아니고, 바르게 사는 것이 중요한 문제이다.",
  "author": "소크라테스",
  "theme": "wisdom",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "33ad4aeb5665d5d599917151fb699942293e74ea",
  "text": "법은 질서이며, 좋은 법은 좋은 질서이다.",
  "author": "아리스토텔레스",
  "theme": "wisdom",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "3df18cf37bc07de7e91669c0d2c06baea33be9ff",
  "text": "가는 자는 쫓지 말며, 오는 자는 막지 말라.",
  "author": "맹자",
  "theme": "wisdom",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "4070b1e76ca375549bcad08d96d696ca2ede14ca",
  "text": "진실은 복잡함이나 혼란 속에 있지 않고, 언제나 단순함 속에서 찾을 수 있다.",
  "author": "아이작 뉴턴",
  "theme": "wisdom",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "727a836b51870eeb6dd7747f33f5d3702dafd3c6",
  "text": "나는 천체의 운동을 계산할 수 있지만, 사람들의 광기를 계산하지는 못한다.",
  "author": "아이작 뉴턴",
  "theme": "wisdom",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "7bd2706386605ecd06ecc9c2e88cc7d2b3446d87",
  "text": "너무 재주가 많은 자는 수고가 많고 너무 영리한 자는 쓸데없는 걱정으로 고생이 많다.",
  "author": "장자",
  "theme": "wisdom",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "7c4c8fa1f67fdc7a83dd4dc71f65e01401811d57",
  "text": "아는 것이 힘이다.",
  "author": "프랜시스 베이컨",
  "theme": "wisdom",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "867427e2a727e053a2e194715030c138812657ba",
  "text": "너에게서 나온 것은 너에게로 돌아간다.",
  "author": "맹자",
  "theme": "wisdom",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "a286ff0a84cc08804ec50f1ecafaacb2d42ad95d",
  "text": "나는 나의 스승을 사랑하지만 진리를 더 사랑한다.",
  "author": "아리스토텔레스",
  "theme": "wisdom",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "ca30e8f9f554a00e6d6574ff7f6278f63a385c59",
  "text": "왕좌란 벨벳으로 덮은 목판에 불과하다.",
  "author": "나폴레옹 보나파르트",
  "theme": "wisdom",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "cc36247cbd94dc26e10dbe6362d37361d496adbd",
  "text": "인간은 천성적으로 정치적(사회적) 동물이다.",
  "author": "아리스토텔레스",
  "theme": "wisdom",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "cc4de8d4f6cd46703637cfd0d93b43c2926ef471",
  "text": "앞을 내다보지 못하는 자는 이미 패배한 자이다.",
  "author": "나폴레옹 보나파르트",
  "theme": "wisdom",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "fb887bbad15bb670e8005c39989856a352258758",
  "text": "남을 아는 사람은 지혜 있는 자이지만, 자기를 아는 사람은 더욱 명석한 자이다.",
  "author": "노자",
  "theme": "wisdom",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "fc54062ef87f553df5dc296ac37ee2d948fd08da",
  "text": "내가 가치 있는 발견을 했다면, 다른 능력이 있어서라기 보다는 참을성 있게 관찰한 덕분이다.",
  "author": "아이작 뉴턴",
  "theme": "wisdom",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "1be2cb665ef3f6906cced7062f6a4bd6ccc60757",
  "text": "친구를 고를 때는 천천히, 친구를 바꿀 때는 더 천천히 해라.",
  "author": "벤저민 프랭클린",
  "theme": "relationship",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "25ec696c15baaa29f5ce93082b4e9a89fa2ddeac",
  "text": "친구는 제2의 재산이다.",
  "author": "아리스토텔레스",
  "theme": "relationship",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "520fdd1b1c9df3c7706942d305845789e3af94ad",
  "text": "나는 거인의 어깨위에 앉았기 때문에 더 멀리 내다 볼 수 있었다.",
  "author": "아이작 뉴턴",
  "theme": "relationship",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "5225916bf66e0edc7cd4b77be66f6f820addd681",
  "text": "선한 사람도 내가 선하게 대하고, 선하지 않은 사람도 내가 역시 선하게 대한다면, 모두가 선인이 될 것이다.",
  "author": "노자",
  "theme": "relationship",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "5c68382f69a01e14940e2f99ace0cea2e56f0d7c",
  "text": "옳은 일을 권하는 것이 친구의 도리이다.",
  "author": "맹자",
  "theme": "relationship",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "5cc2a608a8dce648e4ff13c3f6602a25c90c440b",
  "text": "부모를 공경하는 효행은 쉬우나, 부모를 사랑하는 효행은 어렵다.",
  "author": "장자",
  "theme": "relationship",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "779c6fac56618fed9837a3e32c4c3f4cd9bb7850",
  "text": "누구에게나 친구는 어느 누구에게도 친구가 아니다.",
  "author": "아리스토텔레스",
  "theme": "relationship",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "7afa95386d65bd9dce53760e3844629774216389",
  "text": "사회생활을 하지 못하거나, 혼자로도 충분하기 때문에 사회가 필요없는 사람은 짐승이거나 신이 틀림없다.",
  "author": "아리스토텔레스",
  "theme": "relationship",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "d45765f42f4d809f497b36026fa86c5eb94a53fa",
  "text": "사람이면 다 존귀하다",
  "author": "나혜석",
  "theme": "relationship",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "f3b799826b6fff66d11858c8a31ce573ea911eef",
  "text": "다른 사람의 속마음으로 들어가라. 그리고 다른 사람으로 하여금 당신의 속마음으로 들어오도록 하라.",
  "author": "마르쿠스 아우렐리우스",
  "theme": "relationship",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "11b18ae6a102e4201919a9fe8776d8c4738c20b3",
  "text": "내 몸이 제일 소중하다.",
  "author": "나혜석",
  "theme": "health",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "44038ae771af99436f954107c00eedd765fdf114",
  "text": "사는 것은 몸으로 사는 것이 아니라 마음으로 사는 것이야.",
  "author": "나혜석",
  "theme": "health",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "4a95b30e8a5203db5138887be90df9923b55df0b",
  "text": "병은 미리 걱정하는 데서 생기고, 죽음은 일찍부터 보호를 잘못하는 데 있다.",
  "author": "김시습",
  "theme": "health",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "765d345806df4f5a6d46c3d29df161339d7a7071",
  "text": "살아 있는 졸병이 죽은 황제보다 훨씬 가치가 있다.",
  "author": "나폴레옹 보나파르트",
  "theme": "health",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "a15ba48b2205239fe73f1c98b2e629b0aa5f8cb1",
  "text": "근심 걱정을 치료하는 데는 위스키보다 일이 낫다.",
  "author": "토머스 에디슨",
  "theme": "health",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "b32de1f8f65c5ce627fd83572899f7aa32702fbd",
  "text": "유한한 목숨으로써 어찌 무한한 욕심을 따르려 하는가.",
  "author": "장자",
  "theme": "health",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "be1cb713fa6c87e7bdece417c94603f50ed696e3",
  "text": "천하의 모든 물건 중에는 내 몸보다 더 소중한 것이 없다. 그런데 이 몸은 부모가 주신 것이다.",
  "author": "이이",
  "theme": "health",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "f604a11b80bfb820eeeead90367ac7e8af567e1b",
  "text": "식사, 수면, 운동 시간에 아무것도 생각하지 않고 쾌활한 것은 최량의 장수법이다.",
  "author": "프랜시스 베이컨",
  "theme": "health",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "02a5b5889ad116e73bf6042360fe0b1ff413a93e",
  "text": "기회는 준비되어 있는 정신이 필요하다.",
  "author": "루이 파스퇴르",
  "theme": "growth",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "229634780c203d50fa3a0fa80df06c62fa67a9b3",
  "text": "성격의 씨앗을 뿌리면, 운명의 열매가 열린다.",
  "author": "나폴레옹 보나파르트",
  "theme": "growth",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "268f0721f089fc776a02ef6e0df7158a0551d94b",
  "text": "널리 배우고 상세하게 말하는 것은 장차 돌이켜 간략하게 말하기 위해서이다.",
  "author": "맹자",
  "theme": "growth",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "27b1dfd6f0e60bd72bfabbc2bbf5951c5b965ec2",
  "text": "지식에 투자하는 것이 가장 이윤이 높다.",
  "author": "벤저민 프랭클린",
  "theme": "growth",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "43f011ad92be87d73245b4cc19c8fe4ca92ae4ea",
  "text": "돈을 빌리러 가는 것은 자유를 팔러 가는 것이다.",
  "author": "벤저민 프랭클린",
  "theme": "growth",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "47a81ed5f452a82e1184e8eaec87c1efdf2b57cc",
  "text": "너는 머뭇거릴 수 있지만, 시간은 그렇지 않다.",
  "author": "벤저민 프랭클린",
  "theme": "growth",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "521b54078958f7280b4c9151cb2d87470c5e652c",
  "text": "오늘 할 수 있는 일에 최선을 다해라.",
  "author": "아이작 뉴턴",
  "theme": "growth",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "636b7dbf5b399c4316b25b4ea7ce87aa412145c5",
  "text": "과학지식은 추측과 반박을 통해 성장한다.",
  "author": "칼 포퍼",
  "theme": "growth",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "78e236dfb079af2f0fd4fa75d3f53bc90a11fa07",
  "text": "가지고 싶은 것은 사지마라. 꼭 필요한 것만 사라. 작은 지출을 삼가해라. 작은 구멍이 거대한 배를 침몰시킨다.",
  "author": "벤저민 프랭클린",
  "theme": "growth",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "79ccf3b00d2400dd1853d7fc0695957d08d68406",
  "text": "근면하고 시간을 낭비하지 말라. 항상 유익한 일을 하고 모든 무익한 일을 하지 말라.",
  "author": "벤저민 프랭클린",
  "theme": "growth",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "81189ec8427736937268316baa7c3603e6dde0f1",
  "text": "게으름은 쇠붙이의 녹과 같다. 노동보다도 더 심신을 소모 시킨다.",
  "author": "벤저민 프랭클린",
  "theme": "growth",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "8b3ad65f05d3ff1786959dae04d593098c551eca",
  "text": "태만은 천천히 움직이므로 가난이 곧 따라잡는다.",
  "author": "벤저민 프랭클린",
  "theme": "growth",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "96d96cc99f355893ba0c919c1b5f30f2d9216de4",
  "text": "기다릴 수 있는 능력이야 말로 성공의 가장 큰 비밀이다.",
  "author": "조제프 드 메스트르 백작",
  "theme": "growth",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "c0a83a901c7c1316a1400faa106d9da178205b24",
  "text": "돈이란 훌륭한 하인이기도 하지만, 나쁜 주인이기도 하다.",
  "author": "벤저민 프랭클린",
  "theme": "growth",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "c17663c6787046369ba3d31ac8944785d55e8678",
  "text": "한가로운 시간은 무엇과도 바꿀 수 없는 재산이다.",
  "author": "소크라테스",
  "theme": "growth",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "d7f08d3104f7fead29e4631fe0875c5cc604cec2",
  "text": "일을 쫓아라. 일에 쫓기지 말라.",
  "author": "벤저민 프랭클린",
  "theme": "growth",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "da752bd0bcb58fb4df2cb057ceb7284688505bfc",
  "text": "가라, 달려라, 그리고 세계가 6일 동안에 만들어졌음을 잊지 말라. 그대는 그대가 원하는 것은 무엇이든지 나에게 청구할 수 있지만 시간만은 안된다.",
  "author": "나폴레옹 보나파르트",
  "theme": "growth",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "edb5b261cb409b8bc66474550ada14e258e77a57",
  "text": "인생에서 실패한 사람의 대부분은 성공이 눈앞에 왔는데도 모르고 포기한 사람들이다.",
  "author": "토머스 에디슨",
  "theme": "growth",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "0e8e9292ada42a907453a24c97b796aa938250d3",
  "text": "성인의 도에 통달한 자는 곤궁하면 그 곤궁을 즐기고, 처지가 뜻대로 되면 그것 또한 즐긴다.",
  "author": "장자",
  "theme": "peace",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "be6162d495888bd8bb7c5aaa253470223e3a5545",
  "text": "두 눈을 감고 우주를 보았다.",
  "author": "레온하르트 오일러",
  "theme": "peace",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "21e23433b335f0d9d5d9f13aa22a2453e60d6f59",
  "text": "나의 사전에는 불가능이란 단어가 없다.",
  "author": "나폴레옹 보나파르트",
  "theme": "vitality",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "2753fb4223dc6c47e4006e794bdb7b9dcc778971",
  "text": "의지할 만한 것은 남이 아니라 자신의 힘이다.",
  "author": "나폴레옹 보나파르트",
  "theme": "vitality",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "2cd7242049357cb64080d9d927d1edbdcdafaaf2",
  "text": "1퍼센트의 가능성, 그것이 나의 길이다.",
  "author": "나폴레옹 보나파르트",
  "theme": "vitality",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "39fdf88508536e6212d7bdb6275d3765b00daebf",
  "text": "잘 싸우는 자는 노하지 않고, 잘 이기는 자는 잘 싸우지 않는다.",
  "author": "노자",
  "theme": "vitality",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "4793ef1bb05fc14d26803e880fc557f5f7420012",
  "text": "용기있는 인간은 무한한 공간으로 진출할 것이다",
  "author": "요하네스 케플러",
  "theme": "vitality",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "71962723fd1526ae660391f51b21a34d3aea6bfd",
  "text": "크게 어려운 일을 당해도 두려워하지 않는 것은 성인의 용기이다.",
  "author": "장자",
  "theme": "vitality",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "91c4b8fd9020d42fd36db99597be2c58a0302e9a",
  "text": "숙고할 시간을 가져라. 그러나 일단 행동할 시간이 되면 생각을 멈추고 돌진하라.",
  "author": "나폴레옹 보나파르트",
  "theme": "vitality",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "986017b01e6c0710e1814c26587dfd578c1b5848",
  "text": "내일 지구가 멸망한다는 것을 알게 되더라도, 나는 한 그루의 사과나무를 심겠다.",
  "author": "바뤼흐 스피노자",
  "theme": "vitality",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "bcfcce53aa974929387a18ab831308f894eff37c",
  "text": "인생의 경쟁에서 육체는 아직 살아 있는데 정신이 기절한다는 것은 정신의 수치이다.",
  "author": "마르쿠스 아우렐리우스",
  "theme": "vitality",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "d13c14f233567ca47fe970668539895e43efa33d",
  "text": "주사위는 던져졌다.",
  "author": "율리우스 카이사르",
  "theme": "vitality",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "dde25728358f079cac57eadef6290665e8cc0906",
  "text": "범인은 이익을 중히 여기고, 청렴한 선비는 명예를 중히 여기며, 현인은 의지를 숭상하고, 성인은 정신을 귀중히 여긴다.",
  "author": "장자",
  "theme": "vitality",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "e67a318018ccf83f78ebe7266ce383b36c688bac",
  "text": "승리를 원한다면, 모든 것을 걸어야 한다.",
  "author": "나폴레옹 보나파르트",
  "theme": "vitality",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "3c1fa24f38240c7f183da16989911997d9be25f1",
  "text": "비장의 무기가 아직 나의 손에 있다. 그것은 희망이다.",
  "author": "나폴레옹 보나파르트",
  "theme": "happiness",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "a41e59e6a86f15a0524b465816d347853555a1c0",
  "text": "사치한 생활 속에서 행복을 구하는 것은 마치 그림 속의 태양이 빛을 발하기를 기다리는 것과 같다.",
  "author": "나폴레옹 보나파르트",
  "theme": "happiness",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "c1d12bcae6aa5d4fe2c270f6dcb88ddf6a68adbe",
  "text": "청년은 희망의 그림자를 가지고, 노인은 회상의 그림자를 가진다.",
  "author": "쇠렌 키르케고르",
  "theme": "happiness",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "cb562786c413a6e6e3d1c74ab2147b23fa0033cd",
  "text": "희망이란 눈을 뜨고 꾸는 꿈이다.",
  "author": "아리스토텔레스",
  "theme": "happiness",
  "source": "한국어 위키인용집 (CC BY-SA 4.0)"
 },
 {
  "id": "c62a28690aed65a61d5c1e71c0f5c067",
  "text": "국화는 서리를 맞아도 꺾이지 않는다",
  "author": "우리말 속담",
  "theme": "vitality",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "bcc5355228228392f477e684b728f924",
  "text": "강물이 돌을 굴리지 못한다",
  "author": "우리말 속담",
  "theme": "vitality",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "626df0bb96fc0db4b240c8797fdd3c86",
  "text": "돈 주고 못 살 것은 기개",
  "author": "우리말 속담",
  "theme": "vitality",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "b7cfa60dd63138887a8638e793cdbacd",
  "text": "큰 고기를 낚기 위하여 작은 미끼를 아끼지 말라",
  "author": "우리말 속담",
  "theme": "vitality",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "f34bd4f9f38abfe87521f9dcb64b3a03",
  "text": "말로는 사촌 기와집도 지어 준다",
  "author": "우리말 속담",
  "theme": "vitality",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "b4f9d5db34cf48abcfda17519f873b23",
  "text": "적의 눈과 귀는 멀게 하고 내 눈과 귀는 밝아야 한다",
  "author": "우리말 속담",
  "theme": "vitality",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "b8280bed375c7912c913d6c590e5a06b",
  "text": "말은 쉬워도 행동은 힘들다",
  "author": "우리말 속담",
  "theme": "vitality",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "d194eaaa0998aa493c2f71a757d46f97",
  "text": "백 마디 말보다 실천이 귀중하다",
  "author": "우리말 속담",
  "theme": "vitality",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "ed5edd740e07576fdaf084f024d27b27",
  "text": "하자고 결심하면 못 해낼 일이 없다",
  "author": "우리말 속담",
  "theme": "vitality",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "26efde04d4aec54e9ed64874a0b1a82b",
  "text": "고기 보고 기뻐만 말고 가서 그물을 떠라[뜨라]",
  "author": "우리말 속담",
  "theme": "vitality",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "f1b1e3cdb7e723458332a14a1d89f00f",
  "text": "웃는 집에 복이 있다",
  "author": "우리말 속담",
  "theme": "happiness",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "1b1a1f8e3a1ea93d6081c5688e6ec409",
  "text": "뒤를 돌아보고 울기보다는 앞을 바라보고 웃으랬다",
  "author": "우리말 속담",
  "theme": "happiness",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "3964be860062efe95f650af8dbca0d4a",
  "text": "배부르니까 평안 감사도 부럽지 않다",
  "author": "우리말 속담",
  "theme": "happiness",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "ec5806926a179b49505493767d61f564",
  "text": "아이 놓고는 웃어도 돈 놓고는 못 웃는다",
  "author": "우리말 속담",
  "theme": "happiness",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "548cc01cb5fbb8ac1a488b0fa014ba01",
  "text": "복 속에서 복을 모른다",
  "author": "우리말 속담",
  "theme": "happiness",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "d059e89652fe3142c72419d6291d85b2",
  "text": "고생 끝에 낙이 온다[있다]",
  "author": "우리말 속담",
  "theme": "happiness",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "f7cac0ac9f1d8f86b6dce30e90eec25b",
  "text": "밤이 깊어 갈수록 새벽이 가까와 온다",
  "author": "우리말 속담",
  "theme": "happiness",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "e99139d5d699db793af47dd48eff02d8",
  "text": "대한 끝에 양춘이 있다",
  "author": "우리말 속담",
  "theme": "happiness",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "ea2563bf8f1e844474630a0814521e44",
  "text": "거지는 논두렁 밑에 있어도 웃음이 있다",
  "author": "우리말 속담",
  "theme": "happiness",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "3a88967492b46040fd2cca1d97eb6240",
  "text": "부지런한 범재가 부지런하지 못한 천재보다 낫다",
  "author": "우리말 속담",
  "theme": "growth",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "25f213e652314ffb6520fe4f35402523",
  "text": "구르는 돌은 이끼가 안 낀다",
  "author": "우리말 속담",
  "theme": "growth",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "d138d423e080a70dd732028c42b9329f",
  "text": "걸음새 뜬 소가 천 리를 간다",
  "author": "우리말 속담",
  "theme": "growth",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "b304cf86deb4b67ac616f1e0f4d21424",
  "text": "십 년 적공이면 한 가지 성공을 한다",
  "author": "우리말 속담",
  "theme": "growth",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "c2abdc2962b9ffe7b65a426201eb9cc4",
  "text": "천 리 길도 한 걸음부터",
  "author": "우리말 속담",
  "theme": "growth",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "4d028d5e4166f7de17a749cb8a18f710",
  "text": "부지런한 부자는 하늘도 못 막는다",
  "author": "우리말 속담",
  "theme": "growth",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "97d915eddd436da79c2d49eafe80295a",
  "text": "새벽달 보려고 으스름달 안 보랴",
  "author": "우리말 속담",
  "theme": "growth",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "7609ff82510278edfd1a95e9567f8276",
  "text": "하늘은 스스로 돕는 자를 돕는다",
  "author": "우리말 속담",
  "theme": "growth",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "cf5885146ab900782e33389658bb798a",
  "text": "개미는 작아도 탑을 쌓는다",
  "author": "우리말 속담",
  "theme": "growth",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "18d05ce18fce9c6d731dfcfed25f3abe",
  "text": "공부는 늙어 죽을 때까지 해도 다 못 한다",
  "author": "우리말 속담",
  "theme": "growth",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "acbfb8c2f42c9a6827a706add238e59c",
  "text": "무쇠도 갈면 바늘 된다",
  "author": "우리말 속담",
  "theme": "growth",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "9b11546dab79b973329f047b51103511",
  "text": "세월은 사람을 기다려 주지 않는다",
  "author": "우리말 속담",
  "theme": "growth",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "fc4f3e630d7fa908e3fc5a1a0b69d388",
  "text": "쇠붙이도 늘 닦지 않으면 빛을 잃는다",
  "author": "우리말 속담",
  "theme": "growth",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "5fd9a5928d773902ce2f259d42435cd5",
  "text": "병 만나기는 쉬워도 병 고치기는 힘들다",
  "author": "우리말 속담",
  "theme": "health",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "9ef258c188863d97f1a7810ba112d5bb",
  "text": "밥 한 알이 귀신 열을 쫓는다",
  "author": "우리말 속담",
  "theme": "health",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "e9d20c0d47b2f502c155427361d03938",
  "text": "병들어야 설움을 안다",
  "author": "우리말 속담",
  "theme": "health",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "2e03e312a9a6405d36eeb04facd1cc30",
  "text": "병 자랑은 하여라",
  "author": "우리말 속담",
  "theme": "health",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "a8ae6c4e9091da6faaf42c20f7e393a5",
  "text": "삼정승 부러워 말고 내 한 몸 튼튼히 가지라",
  "author": "우리말 속담",
  "theme": "health",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "01c01ff5f8e7dd03474e6b18b639283e",
  "text": "콧구멍 둘 마련하기가 다행이라",
  "author": "우리말 속담",
  "theme": "health",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "01801099764ea9d55658657fe3ecb6e4",
  "text": "밥이 약보다 낫다",
  "author": "우리말 속담",
  "theme": "health",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "2fad43fa0ec22ebb7df6e152c568b6f3",
  "text": "긴병에 효자 없다",
  "author": "우리말 속담",
  "theme": "health",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "b952f97c2a0062c560e247a4785add47",
  "text": "병은 사람을 못 잡아도 약은 사람을 잡는다",
  "author": "우리말 속담",
  "theme": "health",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "31e4aef51598d059f3a4977ee4300320",
  "text": "의사가 제 병 못 고친다",
  "author": "우리말 속담",
  "theme": "health",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "7b48698addc6f11355d7006efee17090",
  "text": "고약으로는 속병을 고치지 못한다",
  "author": "우리말 속담",
  "theme": "health",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "8f8628f1ca446315048973056ec84361",
  "text": "늙은이에게는 밥이 막대라",
  "author": "우리말 속담",
  "theme": "health",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "11aa76ca133ccca9dc4a90e5d43fc742",
  "text": "지는 게 이기는 거다",
  "author": "우리말 속담",
  "theme": "peace",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "11a4b35ab70fe95f0485e925f0d19584",
  "text": "기는 놈 위에 나는 놈이 있다",
  "author": "우리말 속담",
  "theme": "peace",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "8a683589fd02ac1499f13c72bd997313",
  "text": "산토끼를 잡으려다가 집토끼를 놓친다",
  "author": "우리말 속담",
  "theme": "peace",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "468d24c959259a06584513088c1ffd7b",
  "text": "재산이 늘수록 욕심도 는다",
  "author": "우리말 속담",
  "theme": "peace",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "fb375d8e9c0047200c207811adbf6c30",
  "text": "만사가 욕심대로라면 하늘에다 집도 짓겠다",
  "author": "우리말 속담",
  "theme": "peace",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "01005c52e700eceab0ec6add03c885c7",
  "text": "허욕에 들뜨면 한 치 앞도 못 본다",
  "author": "우리말 속담",
  "theme": "peace",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "caba94ab6c6fe364438dfb53a40ed00a",
  "text": "바다는 메워도 사람의 욕심은 못 채운다",
  "author": "우리말 속담",
  "theme": "peace",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "3fb789e07aa38e1f3aff3fa9fa56a882",
  "text": "귀신도 빌면 듣는다",
  "author": "우리말 속담",
  "theme": "peace",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "325fec78b8b84a4b15fb439bbfe2e9ec",
  "text": "숙인 머리는 베지 않는다",
  "author": "우리말 속담",
  "theme": "peace",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "5c9da7c5c9a2e52fdf07a7bca232a6bc",
  "text": "벼슬은 높이고 뜻은 낮추어라",
  "author": "우리말 속담",
  "theme": "peace",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "d431a00fb373c083c369700941ed850b",
  "text": "김 안 나는 숭늉이 덥다",
  "author": "우리말 속담",
  "theme": "peace",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "556132f7cb45012ee2dea8274054f66b",
  "text": "남의 일에 흥야항야한다",
  "author": "우리말 속담",
  "theme": "peace",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "c438fdcf538edcb2e3a4c0e2dfbbd05a",
  "text": "개구멍에 망건 치기",
  "author": "우리말 속담",
  "theme": "peace",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "cf3241fc317ae10b82979d0406651f3c",
  "text": "평반에 물 담은 듯",
  "author": "우리말 속담",
  "theme": "peace",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "8dbf8c83ae8e0bce14381300a461e488",
  "text": "웃는 낯에 침 못 뱉는다",
  "author": "우리말 속담",
  "theme": "relationship",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "7e8835bf2ffdc13cba07a369929760a1",
  "text": "일가 싸움은 개싸움",
  "author": "우리말 속담",
  "theme": "relationship",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "9c01255f4ec39a2fa64af96a610ccd2a",
  "text": "가는 떡이 커야 오는 떡이 크다",
  "author": "우리말 속담",
  "theme": "relationship",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "72d4f3f5834f7ffc394e1939c8e5cda5",
  "text": "부모 명 잘 받드는 사람이 나라도 잘 받든다",
  "author": "우리말 속담",
  "theme": "relationship",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "a3e3ee93cd50d357c599de3bbeb31d9e",
  "text": "선영 덕은 못 입어도 인심 덕은 입는다",
  "author": "우리말 속담",
  "theme": "relationship",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "b8a2194c5884dee8e661091e904b70ae",
  "text": "자식이 부모 사랑 절반만 해도 효자다",
  "author": "우리말 속담",
  "theme": "relationship",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "f2f3b9b18b82b7147661a880c3d0ffe0",
  "text": "가까운 남이 먼 일가보다 낫다",
  "author": "우리말 속담",
  "theme": "relationship",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "308c4f86535cdec56da0a6a6d7c14d9c",
  "text": "미운 사람 고운 데 없고 고운 사람 미운 데 없다",
  "author": "우리말 속담",
  "theme": "relationship",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "6b5b4a1ea919a4ff01adfd3198e7f97a",
  "text": "부모가 착해야 효자(가) 난다",
  "author": "우리말 속담",
  "theme": "relationship",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "583290395e6222895076301d03c747f3",
  "text": "보금자리 사랑할 줄 모르는 새는 없다",
  "author": "우리말 속담",
  "theme": "relationship",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "d69dc4cd36b852de7296511f915beb4b",
  "text": "오다가다 옷깃만 스쳐도 전세의 인연이다",
  "author": "우리말 속담",
  "theme": "relationship",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "ed6109672f960021f47c97f9076fd83c",
  "text": "좋은 친구가 없는 사람은 뿌리 깊지 못한 나무와 같다",
  "author": "우리말 속담",
  "theme": "relationship",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "b909425fdf0ef0f3275f19e987d6712a",
  "text": "이웃이 사촌보다 낫다",
  "author": "우리말 속담",
  "theme": "relationship",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "1691fecd4672c5e37dbd8bce51305c50",
  "text": "소나무가 무성하면 잣나무도 기뻐한다",
  "author": "우리말 속담",
  "theme": "relationship",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "d9409d9436b7b31e4aad671a3091d17c",
  "text": "내리사랑은 있어도 치사랑은 없다",
  "author": "우리말 속담",
  "theme": "relationship",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "e872b0aa434a407aab2f104a3a3c0015",
  "text": "겨울이 지나지 않고 봄이 오랴",
  "author": "우리말 속담",
  "theme": "wisdom",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "475bcc556745af25ba3d0823eba7a3bf",
  "text": "넘어진 김에 쉬어 간다",
  "author": "우리말 속담",
  "theme": "wisdom",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "2c1a5026e3a9047273822978970b9537",
  "text": "누울 자리 봐 가며 발을 뻗어라",
  "author": "우리말 속담",
  "theme": "wisdom",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "3617efca91a7c43879dd9cc8909e7a48",
  "text": "셈 센 아버지가 참는다",
  "author": "우리말 속담",
  "theme": "wisdom",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "40b976704260e9789dc4f60737c82328",
  "text": "무식은 암흑이요 지식은 광명이다",
  "author": "우리말 속담",
  "theme": "wisdom",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "c3fd9fdacfd7fc248ca424e1e07c4e34",
  "text": "말은 바른대로 하고 큰 고기는 내 앞에 놓아라",
  "author": "우리말 속담",
  "theme": "wisdom",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "4078a23e88b20c6960f86423dd8384e2",
  "text": "살은 쏘고 주워도 말은 하고 못 줍는다",
  "author": "우리말 속담",
  "theme": "wisdom",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "4dd6f8c033fc724d87c2ddb889a81a22",
  "text": "가루는 칠수록 고와지고 말은 할수록 거칠어진다",
  "author": "우리말 속담",
  "theme": "wisdom",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "adad1dec37b210415ed4aa1966833e3d",
  "text": "거짓말은 도둑놈 될 장본",
  "author": "우리말 속담",
  "theme": "wisdom",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "b9fda6046ffcb0adad2f97e3a7400ca8",
  "text": "말이 많으면 실언이 많다",
  "author": "우리말 속담",
  "theme": "wisdom",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "6be008dd89206af8229d98c883a875a4",
  "text": "못난이 열 명의 꾀가 잘난이 한 명의 꾀보다 낫다",
  "author": "우리말 속담",
  "theme": "wisdom",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "4bde424974cfc9917d2a5b8bdf60d381",
  "text": "관 속에 들어가도 막말은 말라",
  "author": "우리말 속담",
  "theme": "wisdom",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "b466643a3db070a6972dcb33d1d1627a",
  "text": "구관이 명관이다",
  "author": "우리말 속담",
  "theme": "wisdom",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "ffd0a2dfc6ed4234c97dbda956fa29e1",
  "text": "사람 위에 사람 없고 사람 밑에 사람 없다",
  "author": "우리말 속담",
  "theme": "wisdom",
  "source": "국립국어원 우리말샘"
 },
 {
  "id": "0d236d68160956326fe3839a4c7f6efe",
  "text": "서당 개 삼 년에 풍월(을) 한다[읊는다/짓는다]",
  "author": "우리말 속담",
  "theme": "wisdom",
  "source": "국립국어원 우리말샘"
 }
]
